# Production .env template
# Copy to `.env` on the server and заполните значения.

# Django
DJANGO_SECRET_KEY=change-me-to-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ustabim.online,www.ustabim.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://ustabim.online,https://www.ustabim.online
DJANGO_CORS_ALLOWED_ORIGINS=https://ustabim.online,https://www.ustabim.online
USE_X_FORWARDED_HOST=True
USE_SECURE_PROXY_HEADER=True

# Security (HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=same-origin

# Database
POSTGRES_DB=ustabim
POSTGRES_USER=ustabim
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT / Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=postmessage
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400
# JWT_SECRET_KEY=optional-separate-signing-key

# Misc
TIME_ZONE=UTC
LOG_LEVEL=INFO
AUTH_THROTTLE_RATE=20/min
ANON_THROTTLE_RATE=100/day
USER_THROTTLE_RATE=1000/day
USE_SQLITE_FOR_TESTS=False
SITE_ID=1

# Frontend (Vite) used at build time
VITE_API_BASE_URL=https://ustabim.online/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=postmessage

# Finik Payments (use prod base URL in production)
FINIK_BASE_URL=https://api.acquiring.averspay.kg
FINIK_API_KEY=your-finik-api-key
# PEM can be inline or a file path
FINIK_PRIVATE_PEM=/secrets/finik_private.pem
FINIK_PUBLIC_PEM=/secrets/finik_public.pem
FINIK_ACCOUNT_ID=your-finik-account-id
FINIK_MERCHANT_CATEGORY_CODE=0742
FINIK_QR_NAME=USTABIM
FINIK_REDIRECT_URL=https://ustabim.online/payment/success
FINIK_WEBHOOK_URL=https://ustabim.online/api/payments/finik/webhook
FINIK_WEBHOOK_SKEW_MS=300000
FINIK_TIMEOUT_SECONDS=15
