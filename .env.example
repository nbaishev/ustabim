# Django
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
# Database
POSTGRES_DB=ustabim
POSTGRES_USER=ustabim
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT / Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=postmessage
# GOOGLE_DEV_BYPASS_TOKEN=dev-token
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400

# Misc
TIME_ZONE=UTC
LOG_LEVEL=INFO
AUTH_THROTTLE_RATE=20/min
ANON_THROTTLE_RATE=100/day
USER_THROTTLE_RATE=1000/day
USE_SQLITE_FOR_TESTS=True
USE_SECURE_PROXY_HEADER=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=same-origin

SITE_ID=1

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=postmessage
# VITE_DEV_GOOGLE_ID_TOKEN=dev-token

# Finik Payments
FINIK_BASE_URL=https://beta.api.acquiring.averspay.kg
FINIK_API_KEY=your-finik-api-key
# FINIK_*_PEM can be inline PEM (with \n) or a path to a PEM file
FINIK_PRIVATE_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FINIK_PUBLIC_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# FINIK_PRIVATE_PEM=/secrets/finik_private.pem
# FINIK_PUBLIC_PEM=/secrets/finik_public.pem
FINIK_ACCOUNT_ID=your-finik-account-id
FINIK_MERCHANT_CATEGORY_CODE=0742
FINIK_QR_NAME=your-qr-name
FINIK_QR_EXPIRES_MINUTES=30
FINIK_REDIRECT_URL=https://your-domain.com/payment/success
FINIK_WEBHOOK_URL=https://your-domain.com/api/payments/finik/webhook
FINIK_WEBHOOK_SKEW_MS=300000
FINIK_TIMEOUT_SECONDS=15
